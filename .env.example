# ==========================================
# MUSE2API 配置环境变量示例
# 复制为 .env 即可生效: cp .env.example .env
# ==========================================

# 必填：在私有配置中设置独立随机密钥；镜像部署不接受空值或示例值。
# .env 需为 0600，不提交真实密钥、不将配置打印到日志。
MUSE2API_KEY=replace-with-a-private-random-key

# 管理端独立密码：不与业务 API Key 共用。托管部署强制开启登录。
# 在私有 .env 中设置，修改后通过工作流重建容器；不要打印或提交真实密码。
MUSE2API_ADMIN_LOGIN_REQUIRED=1
MUSE2API_ADMIN_PASSWORD=replace-with-a-private-admin-password
MUSE2API_ADMIN_SESSION_TTL=28800

# 服务监听地址与端口（Docker 容器内需设为 0.0.0.0）
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610
# Compose 只额外开放指定局域网地址，并保留 Cloudflared 的 127.0.0.1 入口。
MUSE2API_LAN_HOST=192.168.3.5

# 外部公开访问地址（供下游客户端接入及管理页拼接使用，如 https://api.yourdomain.com）
# 留空时，管理页面将自动使用当前浏览器访问的主机与端口
MUSE2API_PUBLIC_BASE=https://muse2api.aiid.edu.kg

# Compose 固定使用托管发布模式；代码更新通过 GitHub Actions。
# 此文件可写挂载到 /app/.env，由应用加载；不要再次用 env_file 注入密钥。
MUSE2API_MANAGED_DEPLOYMENT=1

# Chromium 浏览器可执行文件路径
# Linux/Docker 通常为 /usr/bin/chromium 或 /usr/bin/chromium-browser
# Windows 本地运行可设为 Chrome 完整路径或留空自动查找
MUSE2API_CHROMIUM=/usr/bin/chromium

# CDP 远程调试通信端口
MUSE2API_CDP_PORT=19210

# 任务超时控制（单位：秒）
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# 最大并发生成任务数（支持随服务器资源自由调高，默认 2）
MUSE2API_CONCURRENCY=2

# 是否对后台禁用的账号执行自动保活（0=关闭，1=开启）
# 开启后已禁用账号仍会执行静默保活与会话续期，但不会被路由参与正常生成与对话
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# 参考图安全开关（默认安全；仅可信单用户部署才考虑显式设为 1）
# 1：允许 API 请求读取服务器本地文件路径
MUSE2API_REF_IMAGE_LOCAL_FILES=0
# 1：允许 API 请求下载内网/本机 URL；0 时逐跳检查并仅允许公网 IP
MUSE2API_REF_IMAGE_PRIVATE_FETCH=0

# S3-center 原始结果存储（也可登录管理端在“S3 结果存储”中配置）。
# 管理端保存的配置优先；Token 留空保存时保留原值，接口不回显 Token。
# 默认关闭。启用后图片和视频原字节上传；失败保留本地成品，可单独重试转存。
MUSE2API_RESULT_S3_ENABLED=0
MUSE2API_S3_CENTER_API_BASE=
MUSE2API_S3_CENTER_TOKEN=
MUSE2API_S3_CENTER_BUCKET=assets
MUSE2API_S3_CENTER_KEY_PREFIX=aicontent/ai-muse
